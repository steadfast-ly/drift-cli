  "openapi": "3.1.1",
  "paths": {
    "/environments": {
      "get": {
        "operationId": "environments.list",
        "summary": "List environments",
        "description": "Environments newest first. Pass `status` one or more times to narrow to a status set; omit it for every environment including terminal ones.",
        "tags": [
          "environments"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "allowReserved": true
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            },
            "allowReserved": true
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "requested",
                  "building",
                  "build_failed",
                  "deploying",
                  "running",
                  "sleeping",
                  "waking",
                  "deploy_failed",
                  "destroying",
                  "destroyed",
                  "canceled"
                ],
                "type": "string"
              }
            },
            "style": "form",
            "explode": true,
            "allowReserved": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentPage"
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "401": {
            "description": "401",
