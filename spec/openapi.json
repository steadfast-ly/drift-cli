{
  "info": {
    "title": "Drift API",
    "version": "1.0.0",
    "description": "Read surface of drift's versioned API. Authenticate with a CLI bearer credential or a browser session cookie; when both are presented the bearer wins and a bearer that fails to verify is a 401, never a fallback. Every operation enforces a role floor server-side. Errors share one envelope: `{ defined, code, status, message, data }`, where `data.type` is a `urn:drift:problem:` identifier."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "drift-cli-credential",
        "description": "A drift CLI credential: `Authorization: Bearer drift_<token>`. Minted from the drift credentials page, shown once, hashed at rest, carrying a role snapshot capped at the minting user's role, and revocable with effect from the next request. Takes precedence over `cookieAuth` when both are present."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Auth.js session cookie, set by the browser sign-in flow. Over HTTPS the cookie is named `__Secure-authjs.session-token`; send whichever one sign-in set."
      }
    },
